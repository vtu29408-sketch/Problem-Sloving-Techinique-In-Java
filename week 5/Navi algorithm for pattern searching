#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    vector<int> search(string& text, string& pattern) {
        vector<int> answer;

        int n = text.size();
        int m = pattern.size();

        for (int i = 0; i <= n - m; i++) {
            int j = 0;

            while (j < m && text[i + j] == pattern[j]) {
                j++;
            }

            if (j == m) {
                answer.push_back(i);
            }
        }

        return answer;
    }
};
